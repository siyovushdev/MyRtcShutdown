<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="280dp"
        android:layout_marginRight="280dp"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical">

            <ru.firstmt.myrtcshutdown.view.ItemView
                android:background="@drawable/top_view_select_bg"
                android:id="@+id/item_cancel"
                android:focusableInTouchMode="true"
                android:focusable="true"
                android:layout_alignParentStart="true"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="5dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/ic_baseline_close_24" />
            </ru.firstmt.myrtcshutdown.view.ItemView>

            <ru.firstmt.myrtcshutdown.view.ItemView
                android:background="@drawable/top_view_select_bg"
                android:id="@+id/item_commit"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_alignParentEnd="true"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="20dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/ic_baseline_check_24" />
            </ru.firstmt.myrtcshutdown.view.ItemView>

        </RelativeLayout>

        <TextView
            android:layout_marginStart="5dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:text="Timed power on/off"
            android:textColor="@color/black"
            android:textSize="30sp" />


        <androidx.appcompat.widget.SwitchCompat
            app:switchMinWidth="60dp"
            android:layout_marginStart="5dp"
            android:id="@+id/switch_on"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/item_select_bg"
            android:text="Timed startup"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:track="@drawable/switch_check_bg" />

        <RelativeLayout
            android:layout_marginEnd="20dp"
            android:layout_marginStart="5dp"
            android:id="@+id/relat_on"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/item_select_bg"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:text="on time"
                android:gravity="center_vertical"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <RelativeLayout
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/text_on_time"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="22dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="16:00"
                    android:textColor="@color/black"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/ic_baseline_chevron_right_24" />
            </RelativeLayout>


        </RelativeLayout>

        <androidx.appcompat.widget.SwitchCompat
            app:switchMinWidth="60dp"
            android:layout_marginStart="5dp"
            android:id="@+id/switch_on_repeat"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/item_select_bg"
            android:text="repeat"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:track="@drawable/switch_check_bg" />

        <View
            android:layout_marginLeft="5dp"
            android:layout_marginRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/black" />

        <androidx.appcompat.widget.SwitchCompat
            app:switchMinWidth="60dp"
            android:layout_marginStart="5dp"
            android:id="@+id/switch_off"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/item_select_bg"
            android:text="Timed shutdown"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:track="@drawable/switch_check_bg" />

        <RelativeLayout
            android:layout_marginEnd="20dp"
            android:layout_marginStart="5dp"
            android:id="@+id/relat_off"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/item_select_bg"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:text="off time"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <RelativeLayout
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/text_off_time"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="22dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="16:00"
                    android:textColor="@color/black"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/ic_baseline_chevron_right_24" />
            </RelativeLayout>

        </RelativeLayout>

        <androidx.appcompat.widget.SwitchCompat
            app:switchMinWidth="60dp"
            android:layout_marginStart="5dp"
            android:id="@+id/switch_off_repeat"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/item_select_bg"
            android:text="repeat"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:track="@drawable/switch_check_bg" />
    </LinearLayout>


</LinearLayout>